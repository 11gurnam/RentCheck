# The public introduction works without credentials. Accounts require a test backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never expose privileged keys through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://127.0.0.1:3000
# Enable only after the provider is configured in Supabase.
GOOGLE_AUTH_ENABLED=false
# Public operator details required by the hosted deployment preflight.
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=

# Optional multilingual review checking, server-side only. Obtain a key from Google AI Studio.
# Use a project without billing to stay within free-tier quotas.
# Free-tier review text may be used by Google to improve products.
GEMINI_API_KEY=
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite

# Optional map-provider overrides. Defaults require no account or API key.
ADDRESS_LOOKUP_URL=https://photon.komoot.io
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
